# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com/api-keys) - transactional email (booking confirmations, receipts)
RESEND_API_KEY=
RESEND_FROM_EMAIL=bookings@quickpic.click

# Cashfree (merchant.cashfree.com/merchants/pg/developers/api-keys)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=SANDBOX

# Public site URL, used for metadata + Cashfree return_url
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Meta / Google ads tracking (add once you set up the pixel + GA4 property)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=
