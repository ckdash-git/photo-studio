# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com/api-keys) - transactional email (booking confirmations, receipts)
RESEND_API_KEY=
RESEND_FROM_EMAIL="QuickPic <bookings@quickpic.click>"

# Cashfree (merchant.cashfree.com/merchants/pg/developers/api-keys)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=SANDBOX

# Public site URL, used for metadata + Cashfree return_url
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Meta / Google ads tracking (add once you set up the pixel + GA4 property)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=

# Your own email - grants access to /admin when you log in with it via the
# normal magic-link flow. No separate admin login/password.
ADMIN_EMAIL=you@example.com

# Pixabay (pixabay.com/api/docs) - free stock photos for the site.
# Server-side only - never exposed to the client.
PIXABAY_API_KEY=
